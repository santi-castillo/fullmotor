generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id             String   @id @default(cuid())
  slug           String   @unique
  brand          String
  model          String
  year           Int
  version        String?
  category       String
  subcategory    String?
  priceUYU       Float?
  priceUSD       Float?
  engineCc       Int?
  engineHp       Int?
  engineTorque   Int?
  fuelType       String?
  transmission   String?
  gears          Int?
  length         Int?
  width          Int?
  height         Int?
  wheelbase      Int?
  trunkCapacity  Int?
  fuelTank       Int?
  weight         Int?
  safetyFeatures String?
  equipment      String?
  images         String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
