# API del catálogo
NEXT_PUBLIC_API_URL=https://api.todomotor.uy
NEXT_PUBLIC_COUNTRY=uy
NEXT_PUBLIC_SITE_URL=https://todomotor.uy

# Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Medición.
#
# Vercel Analytics y Speed Insights se activan solos con el deploy y no usan
# cookies. GA4 sí: si esta variable falta, el tag de Google y el banner de
# consentimiento no se renderizan, y el sitio sigue midiendo con Vercel.
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Secretos de servidor (no se exponen al navegador)
API_SECRET_KEY=
UPLOAD_API_KEY=
REVALIDATE_SECRET=
INDEXNOW_TRIGGER_SECRET=
INDEXNOW_KEY=
BLOB_READ_WRITE_TOKEN=
